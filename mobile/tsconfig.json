{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Some shared modules import siblings as "./rss.ts". That is load-bearing
    // on the server -- its tests run under node --experimental-strip-types,
    // which requires the explicit extension -- so this side allows it rather
    // than the server dropping it. Safe here: noEmit is on, and Metro
    // resolves the explicit file.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      // The four dependency-free lib/ modules shared with the web app —
      // see ../context/architecture.md's Dependency direction section.
      // Metro also needs the matching watchFolders entry in
      // metro.config.js; the alias alone resolves at typecheck time but
      // not at bundle time.
      "@shared/*": [
        "../src/lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
