# SQLite (libsql). Use a volume-mounted path in Docker.
DATABASE_URL="file:./nekostream.db"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# AniList: https://anilist.co/settings/developer
# Redirect URL: http://localhost:3000/api/auth/oauth2/callback/anilist
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""

# MyAnimeList: https://myanimelist.net/apiconfig
# Redirect URL: http://localhost:3000/api/auth/oauth2/callback/mal
MAL_CLIENT_ID=""
MAL_CLIENT_SECRET=""
# MAL only supports the "plain" PKCE method, so the verifier is a fixed value.
# Generate with: openssl rand -hex 32
MAL_CODE_VERIFIER=""

# Optional: the public https origin, if it differs from BETTER_AUTH_URL.
# Only the Stremio addon URL uses it — Stremio Web rejects plain http.
PUBLIC_URL=""
