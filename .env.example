# SQLite (libsql). Use a volume-mounted path in Docker.
DATABASE_URL="file:./nekostream.db"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# AniList: https://anilist.co/settings/developer
# Redirect URL: http://localhost:3000/api/auth/oauth2/callback/anilist
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""

# MyAnimeList: https://myanimelist.net/apiconfig
# Redirect URL: http://localhost:3000/api/auth/oauth2/callback/mal
MAL_CLIENT_ID=""
MAL_CLIENT_SECRET=""
# MAL only supports the "plain" PKCE method, so the verifier is a fixed value.
# Generate with: openssl rand -hex 32
MAL_CODE_VERIFIER=""

# Optional: the public https origin, if it differs from BETTER_AUTH_URL.
# Only the Stremio addon URL uses it — Stremio Web rejects plain http.
PUBLIC_URL=""

# Optional: the mobile client's URL scheme, trailing "://" included. Trusted
# as an origin so the app's OAuth callback is accepted; leave unset if no
# mobile client points at this server. Sign-in from the app fails with
# "Invalid callbackURL" until this matches the scheme in mobile/app.json.
MOBILE_APP_SCHEME="nekostream://"

# Optional: SMTP for the "email me about new episodes" setting. Leave unset
# to leave the feature off — sending becomes a logged no-op instead of an
# error, and the setting has no effect.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SECURE="false"
